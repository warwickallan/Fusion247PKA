{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Fusion247PKA/tools/governor/worktree-guard.mjs --estate C:/Fusion247PKA"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Task",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Fusion247PKA/.claude/hooks/notify-reminder.mjs"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "node C:/Fusion247PKA/.claude/hooks/idle-ding-check.mjs"
          }
        ]
      }
    ]
  }
}
