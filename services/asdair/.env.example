# =====================================================================
# AsdAIr - example environment.  PLACEHOLDER VALUES ONLY.
#
# This file is committed to a PUBLIC repository. It documents variable
# NAMES and SHAPES. It must never contain a real token, key, password,
# connection string or household identifier.
#
# The canonical contract - which process consumes each variable, what
# preflight checks and at what severity, and what breaks without it - is
# services/asdair/CONFIGURATION.md.  This file is the shape; that file is
# the meaning.
#
# Real values live OUTSIDE this repository, under C:\.fusion247\, and are
# passed with `node --env-file=`.  Nothing in this repo opens one.
#
# NOTE: the runtime and cockpit-api are SEPARATE PROCESSES with SEPARATE
# --env-file pairs.  A variable set for one is NOT set for the other.
# Variables used by both are marked [BOTH].
# =====================================================================

# ---------------------------------------------------------------------
# Telegram intake
# ---------------------------------------------------------------------

# Required. From @BotFather. Shape: <digits>:<url-safe token>.
# Preflight: BLOCKING on presence; token shape is reported as ADVISORY.
SHOPPER_BOT_TOKEN=<digits>:<url-safe-bot-token>

# Required. Numeric Telegram user ids, separated by space, comma or
# semicolon.  DEFAULT-DENY: absent or unparseable means nobody is allowed.
# Preflight: BLOCKING - it must PARSE to at least one id, not merely be set.
SHOPPER_ALLOWED_SENDER_IDS=000000000

# Accepted alias for the line above, used by the pre-existing credentials
# file for this bot.  Set ONE of the two.  First non-empty wins.
# SHOPPER_ALLOWED_USER_IDS=000000000

# Optional. Override the durable Telegram offset file. This file is the
# single most loss-bearing piece of state in the product.
# SHOPPER_INTAKE_STATE_FILE=C:/.fusion247/asdair/shopper-intake-state.json

# Optional. Where received list photos are written.
# SHOPPER_INTAKE_MEDIA_DIR=C:/.fusion247/asdair/shopper-media

# Optional. Long-poll window, seconds (clamped).
# SHOPPER_POLL_TIMEOUT_SECONDS=50

# ---------------------------------------------------------------------
# Postgres.  TWO roles, deliberately: the planning role cannot write, so a
# bug CANNOT write.  Preflight connects as each and asserts WHICH role
# answered - a string that connects says nothing about the role behind it.
# ---------------------------------------------------------------------

# Required. Must connect as asdair_ro (SELECT-only).      [BOTH]
# Preflight: BLOCKING - real connection + role identity + grant matrix.
ASDAIR_DB_URL=postgres://asdair_ro:<password>@db.example.invalid:5432/postgres

# Required. Must connect as asdair_rw (narrow write path, no DELETE).
# Preflight: BLOCKING - real connection + role identity.
ASDAIR_WRITE_DB_URL=postgres://asdair_rw:<password>@db.example.invalid:5432/postgres

# Optional. Defaults to 1. Wrong household, silently, if you ever have two.
# ASDAIR_HOUSEHOLD_ID=1

# ---------------------------------------------------------------------
# The model gateway.  Every model call this product makes goes here - never
# through an interactive AI session (Warwick, 2026-08-03).
# ---------------------------------------------------------------------

# Required. OpenAI-compatible base URL, usually ending /v1.
# May carry userinfo, so treat the whole value as a secret.
# Preflight: BLOCKING - the endpoint is actually called.
FUSION_GATEWAY_URL=http://gateway.example.invalid:4000/v1

# Required. Bearer token.
# Preflight: BLOCKING - an authenticated GET /models must return 200.
FUSION_GATEWAY_KEY=replace-with-the-real-gateway-key

# REQUIRED, AND THE ONE MOST EASILY GOT WRONG.
# The code's fallback is `fusion.vision`, which THIS GATEWAY DOES NOT SERVE:
# on 2026-08-03 every photo list died at TRANSCRIBING with "Invalid model
# name" because the fallback was in use.  Set this to an id the gateway
# actually offers - list them with GET {FUSION_GATEWAY_URL}/models.
# Preflight: BLOCKING - the id must appear in that response. An UNSET value
# is a failure, not a default.
FUSION_MODEL_VISION=replace-with-a-model-the-gateway-actually-serves

# ---------------------------------------------------------------------
# Cockpit photo evidence.
# Set this in BOTH env-file pairs.  cockpit-api is a separate process, so
# setting it here alone leaves the Details photo view disabled in silence.
# Preflight: ADVISORY - this process cannot speak for cockpit-api's env.
# ---------------------------------------------------------------------
ASDAIR_MEDIA_ROOT=C:/.fusion247/asdair/shopper-media

# ---------------------------------------------------------------------
# The browser runner.  Chrome is driven over CDP; it is never asked to
# check out, pay, book a slot or enter a password.
# ---------------------------------------------------------------------

# Optional. Preflight: BLOCKING - the executable must exist.
# Defaults to the two standard Program Files locations.
# ASDAIR_CHROME_EXE=C:/Program Files/Google/Chrome/Application/chrome.exe

# Optional. Preflight: BLOCKING - the directory must exist.
# A DEDICATED profile: the runner drives a signed-in session, and falling
# back to the everyday profile fails halfway through a basket.
# ASDAIR_CHROME_PROFILE_DIR=C:/.fusion247/asdair/chrome-profile

# Optional. Preflight: ADVISORY - Chrome is opened when a basket is built,
# not at logon, so "not listening" is normal most of the week.
# ASDAIR_CDP_ENDPOINT=http://127.0.0.1:9222

# ---------------------------------------------------------------------
# Runtime state.  OUTSIDE the repo: the offset, the log and the list
# photos are household personal data.
# TESTS MUST POINT THIS AT SOMETHING DISPOSABLE.
# ---------------------------------------------------------------------
# ASDAIR_RUNTIME_STATE_DIR=C:/.fusion247/asdair
# ASDAIR_RUNTIME_SETTLE_MS=8000

# ---------------------------------------------------------------------
# cockpit-api ONLY - its own --env-file pair, not the runtime's.
# It also needs ASDAIR_DB_URL and ASDAIR_MEDIA_ROOT from above.
# ---------------------------------------------------------------------
# ASDAIR_COCKPIT_PORT=8710
# ASDAIR_COCKPIT_BIND=127.0.0.1
# ASDAIR_COCKPIT_ALLOWED_ORIGIN=https://cockpit.example.invalid
