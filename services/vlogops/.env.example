# VlogOps — environment variable NAMES. No values live here, and none ever will.
#
# Real values live OUTSIDE this repository and are passed to the process by whoever runs
# it — `node --env-file=<path outside this repo>` is this estate's convention. Nothing in
# this repository opens that file, and nothing in this service reads a value from any file
# inside the repository.
#
# The service validates all of these at startup and refuses to run with a missing or
# malformed one, reporting every problem in a single error rather than the first.

# REQUIRED. The Postgres connection string for the Content Seed store. It is the ONLY
# database variable this service has, deliberately: a service with two ways to reach its
# store has two ways to reach the wrong one.
VLOGOPS_DB_URL=

# OPTIONAL. The repository Route 1 reads existing records from. Defaults to the repository
# this service lives in; set it only when intaking from a checkout elsewhere. This is a
# path, not a secret.
VLOGOPS_REPO_ROOT=
